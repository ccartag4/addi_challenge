# Copy this file to `.env` (same folder) and fill in the value. `.env` is git-ignored.
# The pipeline reads the key from the environment; `.env` is loaded automatically if present.
# Without a key, the single command still runs in offline mode from the committed cache.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults shown)
# LUMO_TRIAGE_MODEL=claude-opus-5   # claude-opus-5 | claude-sonnet-5 | claude-haiku-4-5
# LUMO_TRIAGE_EFFORT=medium         # low | medium | high | xhigh | max | none
# LUMO_TRIAGE_MODE=auto             # auto (replay cache, call live if a key exists) | live | offline
